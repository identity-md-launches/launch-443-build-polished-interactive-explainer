{
  "name": "snowmoon-flow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive chapter-by-chapter reader for Vitalik Buterin's short story Snowmoon",
  "license": "GPL-3.0-only",
  "scripts": {
    "extract": "node scripts/extract-chapters.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "node-html-parser": "^7.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
